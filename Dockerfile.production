ARG NODE_IMAGE=node:22.18.0-bookworm-slim@sha256:752ea8a2f758c34002a0461bd9f1cee4f9a3c36d48494586f60ffce1fc708e0e
FROM ${NODE_IMAGE} AS dependencies
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate \
    && pnpm run build

FROM ${NODE_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
RUN groupadd --system --gid 1001 nodeapp \
    && useradd --system --uid 1001 --gid nodeapp nextjs
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY --from=builder --chown=nextjs:nodeapp /app/package.json /app/pnpm-lock.yaml ./
COPY --from=builder --chown=nextjs:nodeapp /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodeapp /app/.next ./.next
COPY --from=builder --chown=nextjs:nodeapp /app/public ./public
USER nextjs
EXPOSE 3000
CMD ["pnpm", "run", "start"]
